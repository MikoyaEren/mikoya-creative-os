# Mikoya Creative OS — environment template
# Copy to .env.local and fill in. Restart `npm run dev` after changes.
# All keys are SERVER-SIDE ONLY. Never prefix secrets with NEXT_PUBLIC_.

# --- Anthropic (product analysis) ---
# Required for "Analyze Product". Without it the app still works with mock/demo data.
CREATIVE_OS_ANTHROPIC_API_KEY=
# Optional overrides — the single model config lives in lib/server/ai/config.ts.
# ANTHROPIC_ANALYSIS_MODEL=claude-opus-5-5
# ANTHROPIC_ANALYSIS_EFFORT=medium   # low | medium | high | xhigh | max

# --- HTML renderer (Phase 5A) ---
# Headless Chromium used to rasterize HTML templates. Defaults to the Playwright-managed browser.
# CREATIVE_OS_CHROMIUM_PATH=/path/to/chrome
# Concurrent render pages per server process (default 3).
# CREATIVE_OS_RENDER_CONCURRENCY=3
# Local store for rendered PNGs and uploaded product assets (default ./.data, git-ignored).
# CREATIVE_OS_DATA_DIR=./.data
# Enable the /dev/templates Template Lab in a production build (always on in development).
# CREATIVE_OS_TEMPLATE_LAB=1

# --- Renderers (future; see lib/prompts/renderer-instructions.ts) ---
IMAGE_MODEL_API_KEY=
VIDEO_MODEL_API_KEY=
UGC_VIDEO_API_KEY=

# --- Asset storage (future: product uploads + rendered outputs) ---
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Database (future: batches, concepts, recipes) ---
DATABASE_URL=
