# Mikoya Creative OS — environment template
# Copy to .env.local and fill in once integrations are built.
# All keys are SERVER-SIDE ONLY. Never prefix secrets with NEXT_PUBLIC_.

# --- Concept writer / product analysis (LLM) ---
ANTHROPIC_API_KEY=
CONCEPT_MODEL=claude-opus-5-5

# --- Renderers (see lib/pipeline/renderers.ts) ---
IMAGE_MODEL_API_KEY=
VIDEO_MODEL_API_KEY=
UGC_VIDEO_API_KEY=

# --- Asset storage (product uploads + rendered outputs) ---
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Database (batches, concepts, recipes) ---
DATABASE_URL=
